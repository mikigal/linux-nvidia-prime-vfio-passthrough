#!/bin/bash
# Exits 0 when nothing holds the GPU, 1 when it is still in use

# GPU PCIe address
GPU="01:00.0"

NVIDIA_CARD="/dev/dri/by-path/pci-0000:$GPU-card"
NVIDIA_RENDER="/dev/dri/by-path/pci-0000:$GPU-render"

# Only root can see nvidia-persistenced holding the device
if [[ "$EUID" -eq 0 ]]; then
    can_check_persistenced=true
else
    can_check_persistenced=false
fi

gpu_pids() {
    {
        fuser /dev/nvidia*
        fuser "$NVIDIA_CARD" "$NVIDIA_RENDER"
    } 2>/dev/null | grep -oE '[0-9]+' | sort -u
}

persistenced_found=false
processes=""

for pid in $(gpu_pids); do
    line=$(ps -ww -p "$pid" -o pid=,user=,comm= 2>/dev/null) || continue

    if [[ "$can_check_persistenced" == true && "$line" == *nvidia-persiste* ]]; then
        persistenced_found=true
        continue
    fi

    processes+="$line"$'\n'
done

if [[ -n "$processes" ]]; then
    echo "NVIDIA GPU is used by:"
    echo "----------------------------------------"
    printf "%-8s %-10s %s\n" "PID" "USER" "COMMAND"

    printf '%s' "$processes" | while read -r pid user cmd; do
        printf "%-8s %-10s %s\n" "$pid" "$user" "$cmd"
    done | sort -n
    exit_code=1
else
    echo "NVIDIA GPU is not used by any process"
    exit_code=0
fi

if [[ "$can_check_persistenced" != true ]]; then
    echo "Cannot verify nvidia-persistenced (root permissions are required)"
elif [[ "$persistenced_found" == true ]]; then
    echo "nvidia-persistenced is working"
fi

exit "$exit_code"
