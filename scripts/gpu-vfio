#!/bin/bash
set -euo pipefail

# GPU PCIe address
GPU="01:00.0"

fail() {
    echo "$1" >&2
    exit 1
}

info() {
    echo "$1"
}

notify() {
    local icon="$1" message="$2" urgency="normal"
    # Only errors stay up until dismissed, so they survive the screens coming back
    [[ "$icon" == dialog-error ]] && urgency="critical"
    sudo -u "#$UID_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_USER/bus" \
        notify-send -i "$icon" -t 3000 -u "$urgency" "GPU Driver" "$message"
}

# Switch back to NVIDIA fully if somehow you can't switch to VFIO:
rollback() {
    local status=$?
    if (( status == 0 )); then
        return 0
    fi
    gpu-nvidia-processes || true # Show the terminal what was using the GPU
    wait_for_modules_released || true
    gpu-nvidia --force || true
    # Notify last so it's on the bottom (gpu-nvidia will have a success)
    notify dialog-error "NVIDIA GPU is in use, Could not switch GPU driver to VFIO" || true
}

safe_modprobe() {
    local output
    if ! output=$(modprobe "$@" 2>&1); then
        # amdgpu keeping a module busy is expected here, anything else is fatal
        echo "$output" | grep -q "Module amdgpu is in use" || fail "$output"
    fi
}

module_refcnt() {
    cat "/sys/module/$1/refcnt" 2>/dev/null || echo 0
}
wait_for_modules_released() {
    local attempt
    local success=1
    for (( attempt = 0; attempt < 20; attempt++ )); do
        if [[ "$(module_refcnt nvidia_drm)" == 0 && "$(module_refcnt nvidia_uvm)" == 0 ]]; then
            success=0
            break
        fi
        sleep "0.2"
    done
    return $success
}

if [[ "$EUID" -ne 0 ]]; then
    fail "root permissions are required"
fi

UID_USER=$(id -u "${SUDO_USER:-1000}" 2>/dev/null || echo 1000)
driver=$(lspci -nnk -s "$GPU" | awk -F': ' '/Kernel driver in use/ {print $2}')

[[ -z "${driver:-}" ]] && fail "Could not find driver in use for $GPU"

if [[ "$driver" == "vfio-pci" ]]; then
    info "vfio-pci is already loaded"
    exit 0
fi

# From here on, reset the GPU to Nvidia if we fail.
trap rollback EXIT

systemctl stop nvidia-persistenced
# Dynamic Boost daemon, laptop-only so it is not installed everywhere
systemctl stop nvidia-powerd 2>/dev/null || true
nvidia-smi -pm 0

# Lets NVIDIA let go of the GPU when you have external monitors attached to it
for dev in "/sys/bus/pci/devices/0000:$GPU"/drm/{card,renderD}[0-9]*; do
    [[ -e "$dev" ]] || continue
    udevadm trigger --action=remove "$dev"
done

if ! wait_for_modules_released; then
    fail "NVIDIA GPU is in use, can not switch driver"
fi

safe_modprobe -r nvidia_uvm || fail "Could not unload nvidia_uvm"
safe_modprobe -r nvidia_drm || fail "Could not unload nvidia_drm"
safe_modprobe -r nvidia_modeset || fail "Could not unload nvidia_modeset"
# Without sleep unloading nvidia module sometimes throws error
sleep 2
safe_modprobe -r nvidia || fail "Could not unload nvidia_modeset"
safe_modprobe -r i2c_nvidia_gpu || fail "Could not unload i2c_nvidia_gpu"

safe_modprobe vfio || fail "Could not load vfio"
safe_modprobe vfio_pci || fail "Could not load vfio_pci"
safe_modprobe vfio_iommu_type1 || fail "Could not load vfio_iommu_type1"

gpu-check
info "Loaded vfio-pci driver successfuly"
notify emblem-success "Switched GPU driver to VFIO"
exit 0
